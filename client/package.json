{
  "name": "xolas",
  "productName": "Xolas",
  "version": "1.0.1",
  "description": "Xolas - Aplicativo Desktop de Comunicação e Transmissão Studio Obsidian",
  "author": "Xolas",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.xolas.desktop",
    "productName": "Xolas",
    "copyright": "Copyright © 2026 Xolas. Todos os direitos reservados.",
    "electronVersion": "34.0.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "LuaN458",
      "repo": "xolas2",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Xolas-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Xolas"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xolas",
      "uninstallDisplayName": "Xolas Desktop",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.9",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "livekit-client": "^2.7.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "34.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
