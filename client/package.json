{
  "name": "xolas",
  "productName": "Xolas",
  "version": "1.0.43",
  "description": "Xolas - Aplicativo Desktop de Comunicação e Transmissão Studio Obsidian",
  "author": "Xolas",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "compile:audio": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize+ /out:electron\\wasapi-loopback.exe electron\\wasapi-loopback.cs",
    "compile:hotkey": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize+ /win32icon:build\\icon.ico /out:electron\\hotkey-helper.exe electron\\hotkey-helper.cs",
    "build": "npm run compile:audio && npm run compile:hotkey && tsc && vite build",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "release": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.xolas.desktop",
    "productName": "Xolas",
    "copyright": "Copyright © 2026 Xolas. Todos os direitos reservados.",
    "electronVersion": "34.0.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/wasapi-loopback.exe",
        "to": "wasapi-loopback.exe"
      },
      {
        "from": "electron/hotkey-helper.exe",
        "to": "hotkey-helper.exe"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "LuaN458",
      "repo": "xolas2"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Xolas-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Xolas"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Xolas",
      "uninstallDisplayName": "Xolas Desktop",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.9",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.11",
    "livekit-client": "^2.7.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "34.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
